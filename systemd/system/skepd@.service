# skepd, running the Zigbee network of the dongle /dev/%I, as the skep user,
# whose group may use its socket, /run/skep/skepd.sock. For instance:
#   systemctl enable --now skepd@ttyUSB0
#   systemctl enable --now "skepd@$(systemd-escape --path serial/by-id/usb-...)"
# skepd(8) tells more.

[Unit]
Description=Zigbee network of /dev/%I
Documentation=man:skepd(8) man:skep(1)

[Service]
Type=notify
# Found in /usr/local/bin or /usr/bin; see skepd(8) for another prefix.
ExecStart=skepd --device /dev/%I
Restart=on-failure
# Not at once: restarting a crash loop at once reaches the start limit, and
# the service would stay down.
RestartSec=5s
# Restarted, too, if its loop stops turning.
WatchdogSec=30s
User=skep
Group=skep
# Access to the dongle: dialout on Debian and Fedora, uucp on Arch.
SupplementaryGroups=dialout
# Of the devices, USB serial adapters only, the dongles' kind: as a class
# rather than /dev/%I, which a dongle plugged in again can come back under
# another number of, while skepd keeps opening it again.
DevicePolicy=closed
DeviceAllow=char-ttyUSB rw
DeviceAllow=char-ttyACM rw
# The socket, for the skep group.
RuntimeDirectory=skep
RuntimeDirectoryMode=0750
# The state, network key included, and device names: for skep only.
StateDirectory=skep
StateDirectoryMode=0700
# Bounds: 32 clients, what they leave unread, and the state.
LimitNOFILE=256
MemoryMax=256M
TasksMax=16
UMask=0077
# skepd needs no privilege, nor the network: its socket and systemd's are
# files, which a network namespace of its own does not hide.
CapabilityBoundingSet=
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
