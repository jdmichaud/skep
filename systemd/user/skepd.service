# skepd, running the Zigbee network of the dongle it finds, as the user, with
# its socket in $XDG_RUNTIME_DIR/skep and its state in $XDG_DATA_HOME/skep,
# as when started by hand:
#   systemctl --user enable --now skepd
# skepd(8) tells more, and how to name the dongle.

[Unit]
Description=Zigbee network
Documentation=man:skepd(8) man:skep(1) man:skep-dbus(7)

[Service]
Type=notify
# Found in /usr/local/bin or /usr/bin; see skepd(8) for another prefix.
ExecStart=skepd
Restart=on-failure
# Not at once: restarting a crash loop at once reaches the start limit, and
# the service would stay down.
RestartSec=5s
# Restarted, too, if its loop stops turning.
WatchdogSec=30s
# Bounds: 32 clients, what they leave unread, and the state.
LimitNOFILE=256
MemoryMax=256M
TasksMax=16
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
