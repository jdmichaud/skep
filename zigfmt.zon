.{
  .indent_width = 2,
  .indent_style = .spaces,
  .line_ending = .lf,
  .max_blank_lines = 1,
  .line_width = 100,
  .trailing_commas = true,
  .space_inside_braces = true,
  .range_spacing = .never,
  .if_blocks = .except_jumps,
  .loop_blocks = true,
  .sort_imports = false,
  .nested_imports = .forbid,
}
