#!/bin/sh
# Refuse to commit unformatted Zig code (see AGENTS.md), checked by the
# zigfmt pinned in build.zig.zon.
# Enable once per clone with: git config core.hooksPath .githooks

if ! zig build fmt-check; then
    echo "pre-commit: files above are not formatted, run 'zig build fmt' and stage the result" >&2
    exit 1
fi
